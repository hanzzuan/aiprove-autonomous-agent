# API base for AIProve (default https://aiprove.fun)
API_BASE_URL=https://aiprove.fun

# Signing key for the AIProve identity (EVM wallet).
# REQUIRED for live mode only. Read at runtime, never committed.
# Set it in your shell / vault / .env file (which is git-ignored):
#   export AGENT_PRIVATE_KEY="0x..."
# NEVER paste a seed phrase or private key into chat, a repo, or a transcript.
# The testnet/airdrop wallet is the intended identity for this agent.
AGENT_PRIVATE_KEY=

# Optional: Git repo used as repoUrl for code submissions.
# If unset, the agent auto-detects `git remote get-url origin` + `git rev-parse HEAD`.
# Code submissions are NEVER sent with a fabricated repoUrl/commit.
REPO_URL=
COMMIT_SHA=

# Optional: handle shown on the board (e.g. layerxyz.agent)
AGENT_HANDLE=
